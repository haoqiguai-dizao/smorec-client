diff --git a/ScreenRecorderLibNative/CaptureExclusion.cpp b/ScreenRecorderLibNative/CaptureExclusion.cpp
new file mode 100644
index 0000000..d73d48c
--- /dev/null
+++ b/ScreenRecorderLibNative/CaptureExclusion.cpp
@@ -0,0 +1,78 @@
+#include "CaptureExclusion.h"
+#include "Log.h"
+#include <inspectable.h>
+#include <dxgi.h>
+#include <windows.ui.h>
+#include <winrt/Windows.Foundation.Collections.h>
+#include <winrt/Windows.Foundation.Metadata.h>
+#include <winrt/Windows.UI.h>
+
+namespace {
+// ABI from Microsoft Windows SDK metadata, also published by microsoft/windows-rs.
+// Defining only these interfaces keeps the existing SDK 26100 toolchain usable.
+struct __declspec(uuid("bb91f61b-218a-587d-8580-2701a74c0525")) DisplaySessionExclusion : ::IInspectable {
+    virtual HRESULT __stdcall SetWindowExclusionList(void* windows, uint64_t* iteration) = 0;
+    virtual HRESULT __stdcall GetWindowExclusionList(void** windows) = 0;
+};
+struct __declspec(uuid("71616dc8-fea5-5741-a3d8-591acc39a9ee")) CaptureFrameConfiguration : ::IInspectable {
+    virtual HRESULT __stdcall get_ConfigurationIteration(uint64_t* iteration) = 0;
+};
+struct SystemModule {
+    HMODULE value = LoadLibraryExW(L"Windows.UI.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    ~SystemModule() { if (value) FreeLibrary(value); }
+};
+struct ApartmentScope {
+    HRESULT status = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+    ~ApartmentScope() { if (SUCCEEDED(status)) CoUninitialize(); }
+};
+}
+
+bool IsDisplayWindowExclusionSupported() noexcept
+{
+    try {
+        ApartmentScope apartment;
+        return winrt::Windows::Foundation::Metadata::ApiInformation::IsMethodPresent(
+            L"Windows.Graphics.Capture.IDisplayGraphicsCaptureSession", L"SetWindowExclusionList");
+    }
+    catch (...) { return false; }
+}
+
+uint64_t ApplyWindowExclusion(
+    winrt::Windows::Graphics::Capture::GraphicsCaptureSession const& session,
+    std::vector<HWND> const& windows)
+{
+    if (windows.empty()) return 0;
+    auto exclusion = session.try_as<DisplaySessionExclusion>();
+    if (!exclusion) throw winrt::hresult_error(E_NOINTERFACE,
+        L"This Windows version cannot exclude visible floating windows from display recording. Select a window recording source.");
+    SystemModule module;
+    using ConvertWindow = HRESULT(WINAPI*)(HWND, ABI::Windows::UI::WindowId*);
+    auto convert = module.value ? reinterpret_cast<ConvertWindow>(GetProcAddress(module.value, "GetWindowIdFromWindow")) : nullptr;
+    if (!convert) throw winrt::hresult_error(E_NOINTERFACE, L"Windows WindowId conversion is unavailable. Select a window recording source.");
+    auto ids = winrt::single_threaded_vector<winrt::Windows::UI::WindowId>();
+    for (HWND window : windows) {
+        if (!IsWindow(window)) throw winrt::hresult_error(E_INVALIDARG, L"A floating window was closed before capture started.");
+        ABI::Windows::UI::WindowId id{};
+        winrt::check_hresult(convert(window, &id));
+        ids.Append(winrt::Windows::UI::WindowId{ id.Value });
+    }
+    auto iterable = ids.as<winrt::Windows::Foundation::Collections::IIterable<winrt::Windows::UI::WindowId>>();
+    uint64_t iteration = 0;
+    winrt::check_hresult(exclusion->SetWindowExclusionList(winrt::get_abi(iterable), &iteration));
+    LOG_INFO(L"FrameFlow per-session exclusion applied: windows=%zu iteration=%llu", windows.size(), iteration);
+    return iteration;
+}
+
+HRESULT CheckWindowExclusionFrame(
+    winrt::Windows::Graphics::Capture::Direct3D11CaptureFrame const& frame,
+    uint64_t requiredIteration) noexcept
+{
+    if (!requiredIteration) return S_OK;
+    try {
+        auto configuration = frame.as<CaptureFrameConfiguration>();
+        uint64_t iteration = 0;
+        winrt::check_hresult(configuration->get_ConfigurationIteration(&iteration));
+        return iteration >= requiredIteration ? S_OK : DXGI_ERROR_WAIT_TIMEOUT;
+    }
+    catch (...) { return winrt::to_hresult(); }
+}
