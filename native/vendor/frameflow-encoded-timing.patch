diff --git a/ScreenRecorderLibNative/SinkWriterInitialization.h b/ScreenRecorderLibNative/SinkWriterInitialization.h
new file mode 100644
index 0000000..3f8b57c
--- /dev/null
+++ b/ScreenRecorderLibNative/SinkWriterInitialization.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <mfidl.h>
+#include <mfreadwrite.h>
+#include <atlbase.h>
+
+// Release a failed writer before shutting down its sink, including recursive retries.
+class SinkWriterInitialization {
+public:
+    SinkWriterInitialization(CComPtr<IMFSinkWriter>& writer, CComPtr<IMFMediaSink>& sink)
+        : m_Writer(writer), m_Sink(sink) {}
+    SinkWriterInitialization(const SinkWriterInitialization&) = delete;
+    SinkWriterInitialization& operator=(const SinkWriterInitialization&) = delete;
+    ~SinkWriterInitialization() { if (!m_Committed) Abort(); }
+    void Abort() {
+        m_Writer.Release();
+        if (m_Sink) m_Sink->Shutdown();
+        m_Sink.Release();
+    }
+    void Commit() noexcept { m_Committed = true; }
+private:
+    CComPtr<IMFSinkWriter>& m_Writer;
+    CComPtr<IMFMediaSink>& m_Sink;
+    bool m_Committed = false;
+};
diff --git a/ScreenRecorderLibNative/StaleWriterMaintenance.cpp b/ScreenRecorderLibNative/StaleWriterMaintenance.cpp
new file mode 100644
index 0000000..e52c3bf
--- /dev/null
+++ b/ScreenRecorderLibNative/StaleWriterMaintenance.cpp
@@ -0,0 +1,16 @@
+#include "StaleWriterMaintenance.h"
+#include <cwchar>
+
+HRESULT MaintainStaleWriter(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream, bool throttlingDisabled) {
+    wchar_t value[16]{};
+    const DWORD length = GetEnvironmentVariableW(L"FRAMEFLOW_CAPTURE_STALE_MAINTENANCE", value, _countof(value));
+    const bool requested = IsStaleObservationRequested(length < _countof(value) ? value : nullptr);
+    if (ShouldObserveStaleWriter(requested, timing != nullptr, throttlingDisabled)) {
+        bool active = false;
+        const HRESULT status = timing->ObserveStaleMaintenance(active);
+        if (FAILED(status) || active) return status;
+    }
+    const HRESULT status = FlushTimingTrackedWriter(timing, writer, stream);
+    return FAILED(status) || !timing ? status : timing->Status();
+}
