diff --git a/ScreenRecorderLibNative/EncodedSampleTiming.cpp b/ScreenRecorderLibNative/EncodedSampleTiming.cpp
new file mode 100644
index 0000000..319bce7
--- /dev/null
+++ b/ScreenRecorderLibNative/EncodedSampleTiming.cpp
@@ -0,0 +1,208 @@
+#include "EncodedSampleTiming.h"
+#include "Log.h"
+#include <atlbase.h>
+#include <mferror.h>
+#include <mfapi.h>
+#include <mftransform.h>
+#include <algorithm>
+#include <cstdarg>
+
+namespace {
+void LogTiming(const wchar_t* format, ...) noexcept {
+    if (!isLoggingEnabled) return;
+    wchar_t text[1536]{};
+    va_list args;
+    va_start(args, format);
+    _vsnwprintf_s(text, _countof(text), _TRUNCATE, format, args);
+    va_end(args);
+    try { _log(L"%s [INFO] [EncodedTiming] %s\n", GetTimestamp().c_str(), text); }
+    catch (...) { /* Diagnostic output must not interrupt sink cleanup. */ }
+}
+}
+
+HRESULT EncodedSampleTiming::Fail(HRESULT result, const wchar_t* reason, LONGLONG pts) {
+    bool first = false;
+    std::size_t pending = 0;
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        if (SUCCEEDED(m_Failure)) { m_Failure = FAILED(result) ? result : E_FAIL; first = true; }
+        result = m_Failure;
+        pending = m_Ledger.Count();
+    }
+    if (first) LogTiming(L"failure reason=%s pts100ns=%lld pending=%llu result=0x%08lx",
+        reason, pts, static_cast<unsigned long long>(pending), result);
+    return result;
+}
+
+HRESULT EncodedSampleTiming::VerifyHardware(IMFSinkWriter* writer, DWORD stream) {
+    CComQIPtr<IMFSinkWriterEx> extended(writer);
+    if (!extended) return Fail(E_NOINTERFACE, L"cannot-inspect-selected-transform");
+    for (DWORD index = 0; index < 16; ++index) {
+        CComPtr<IMFTransform> transform;
+        GUID category{};
+        HRESULT hr = extended->GetTransformForStream(stream, index, &category, &transform);
+        if (FAILED(hr)) break;
+        if (category != MFT_CATEGORY_VIDEO_ENCODER) continue;
+        CComPtr<IMFAttributes> attributes;
+        hr = transform->GetAttributes(&attributes);
+        if (FAILED(hr)) return Fail(hr, L"encoder-attributes-unavailable");
+        UINT32 hardwareUrlLength = 0;
+        hr = attributes->GetStringLength(MFT_ENUM_HARDWARE_URL_Attribute, &hardwareUrlLength);
+        if (FAILED(hr) || !hardwareUrlLength) return Fail(MF_E_TOPO_CODEC_NOT_FOUND, L"selected-encoder-not-confirmed-hardware");
+        wchar_t name[256]{};
+        attributes->GetString(MFT_FRIENDLY_NAME_Attribute, name, _countof(name), nullptr);
+        {
+            std::lock_guard<std::mutex> guard(m_Mutex);
+            m_Active = true;
+        }
+        LogTiming(L"enabled hardwareConfirmed=true encoder=%s transformIndex=%lu capacity=%llu",
+            name[0] ? name : L"unavailable", index, static_cast<unsigned long long>(EncodedTimingLedger::Capacity));
+        return S_OK;
+    }
+    return Fail(MF_E_TOPO_CODEC_NOT_FOUND, L"selected-video-encoder-unavailable");
+}
+
+HRESULT EncodedSampleTiming::RegisterInput(IMFSample* sample, std::uint64_t& token) {
+    LONGLONG pts = -1, duration = 0;
+    HRESULT hr = sample->GetSampleTime(&pts);
+    if (SUCCEEDED(hr)) hr = sample->GetSampleDuration(&duration);
+    if (FAILED(hr)) return Fail(hr, L"input-timing-unavailable", pts);
+    EncodedTimingLedger::Result inserted;
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        if (FAILED(m_Failure)) return m_Failure;
+        if (!m_Active) return MF_E_NOT_INITIALIZED;
+        inserted = m_Ledger.Insert(pts, duration, token);
+        if (inserted == EncodedTimingLedger::Result::Ok) {
+            ++m_Registered;
+            m_HighWater = (std::max)(m_HighWater, static_cast<std::uint64_t>(m_Ledger.Count()));
+            return S_OK;
+        }
+    }
+    const wchar_t* reason = inserted == EncodedTimingLedger::Result::Full ? L"metadata-capacity-exhausted"
+        : inserted == EncodedTimingLedger::Result::Duplicate ? L"duplicate-input-pts" : L"invalid-input-duration";
+    return Fail(MF_E_INVALID_TIMESTAMP, reason, pts);
+}
+
+void EncodedSampleTiming::CompleteInput(std::uint64_t token, HRESULT result) {
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        if (SUCCEEDED(result)) ++m_Accepted;
+        else if (m_Ledger.Cancel(token)) ++m_Cancelled;
+    }
+    if (FAILED(result)) Fail(result, L"input-write-failed");
+}
+
+HRESULT EncodedSampleTiming::RestoreDuration(IMFSample* sample) {
+    if (!sample) return Fail(E_POINTER, L"missing-encoded-sample");
+    LONGLONG pts = -1;
+    HRESULT hr = sample->GetSampleTime(&pts);
+    if (FAILED(hr)) return Fail(hr, L"encoded-pts-unavailable");
+    std::int64_t duration = 0;
+    EncodedTimingLedger::Result matched;
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        if (FAILED(m_Failure)) return m_Failure;
+        matched = m_Ledger.Take(pts, duration);
+    }
+    if (matched != EncodedTimingLedger::Result::Ok) return Fail(MF_E_INVALID_TIMESTAMP, L"unknown-encoded-pts", pts);
+    hr = sample->SetSampleDuration(duration);
+    if (FAILED(hr)) return Fail(hr, L"encoded-duration-set-failed", pts);
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        ++m_Matched;
+    }
+    return S_OK;
+}
+
+void EncodedSampleTiming::OnOutputFailure(HRESULT result) {
+    if (FAILED(result)) Fail(result, L"fragment-sink-rejected-sample");
+}
+
+void EncodedSampleTiming::OnFinalizeFailure(HRESULT result, bool begin) {
+    if (FAILED(result)) Fail(result, begin ? L"fragment-begin-finalize-failed" : L"fragment-end-finalize-failed");
+}
+
+void EncodedSampleTiming::OnFlush(HRESULT result) {
+    if (FAILED(result)) { Fail(result, L"original-stream-flush-failed"); return; }
+    std::lock_guard<std::mutex> guard(m_Mutex);
+    m_FlushDiscarded += m_Ledger.Clear();
+}
+
+std::uint64_t EncodedSampleTiming::BeforeWriterFlush() {
+    std::lock_guard<std::mutex> guard(m_Mutex);
+    return m_Ledger.Watermark();
+}
+
+void EncodedSampleTiming::AfterWriterFlush(std::uint64_t watermark, HRESULT result) {
+    if (FAILED(result)) { Fail(result, L"original-writer-flush-failed"); return; }
+    std::lock_guard<std::mutex> guard(m_Mutex);
+    ++m_WriterFlushes;
+    m_FlushDiscarded += m_Ledger.DiscardThrough(watermark);
+}
+
+HRESULT EncodedSampleTiming::ObserveStaleMaintenance(bool& active) {
+    std::size_t pending = 0;
+    HRESULT status = S_OK;
+    std::uint64_t highWater = 0;
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        active = m_Active;
+        if (!active) return m_Failure;
+        ++m_ObservedStaleChecks;
+        pending = m_Ledger.Count();
+        highWater = m_HighWater;
+        status = m_Failure;
+    }
+    // Propagate a latched asynchronous failure at this maintenance point too.
+    LogTiming(L"staleMaintenance=observe pending=%llu capacity=%llu highWater=%llu timing=0x%08lx",
+        static_cast<unsigned long long>(pending), static_cast<unsigned long long>(EncodedTimingLedger::Capacity), highWater, status);
+    return status;
+}
+
+HRESULT EncodedSampleTiming::Status() {
+    std::lock_guard<std::mutex> guard(m_Mutex);
+    return m_Failure;
+}
+
+HRESULT EncodedSampleTiming::Finalized(HRESULT result) {
+    std::size_t pending = 0;
+    {
+        std::lock_guard<std::mutex> guard(m_Mutex);
+        pending = m_Ledger.Count();
+    }
+    if (SUCCEEDED(result) && pending) Fail(MF_E_INVALID_TIMESTAMP, L"unconsumed-input-after-finalize");
+    std::lock_guard<std::mutex> guard(m_Mutex);
+    if (!m_Reported) {
+        m_Reported = true;
+        LogTiming(L"summary registered=%llu accepted=%llu matched=%llu discardedByOriginalFlush=%llu cancelled=%llu pending=%llu highWater=%llu writerFlushes=%llu observedStaleChecks=%llu finalize=0x%08lx timing=0x%08lx",
+            m_Registered, m_Accepted, m_Matched, m_FlushDiscarded, m_Cancelled,
+            static_cast<unsigned long long>(pending), m_HighWater, m_WriterFlushes, m_ObservedStaleChecks, result, m_Failure);
+    }
+    return FAILED(result) ? result : m_Failure;
+}
+
+HRESULT WriteTimingTrackedSample(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream, IMFSample* sample) {
+    if (!timing) return writer->WriteSample(stream, sample);
+    std::uint64_t token = 0;
+    HRESULT hr = timing->RegisterInput(sample, token);
+    if (FAILED(hr)) return hr;
+    hr = writer->WriteSample(stream, sample);
+    timing->CompleteInput(token, hr);
+    return FAILED(hr) ? hr : timing->Status();
+}
+
+HRESULT FinalizeEncodedTiming(const std::shared_ptr<EncodedSampleTiming>& timing, HRESULT result) {
+    return timing ? timing->Finalized(result) : result;
+}
+
+HRESULT FlushTimingTrackedWriter(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream) {
+    if (!timing) return writer->Flush(stream);
+    // No lock spans COM. Preserve inputs registered after this flush began.
+    const auto watermark = timing->BeforeWriterFlush();
+    const HRESULT hr = writer->Flush(stream);
+    timing->AfterWriterFlush(watermark, hr);
+    return hr;
+}
diff --git a/ScreenRecorderLibNative/EncodedSampleTiming.h b/ScreenRecorderLibNative/EncodedSampleTiming.h
new file mode 100644
index 0000000..72eae38
--- /dev/null
+++ b/ScreenRecorderLibNative/EncodedSampleTiming.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <Windows.h>
+#include <mfidl.h>
+#include <mfreadwrite.h>
+#include <memory>
+#include <mutex>
+#include "EncodedTimingLedger.h"
+
+class EncodedSampleTiming {
+public:
+    HRESULT VerifyHardware(IMFSinkWriter* writer, DWORD stream);
+    HRESULT RegisterInput(IMFSample* sample, std::uint64_t& token);
+    void CompleteInput(std::uint64_t token, HRESULT result);
+    HRESULT RestoreDuration(IMFSample* sample);
+    void OnOutputFailure(HRESULT result);
+    void OnFinalizeFailure(HRESULT result, bool begin);
+    void OnFlush(HRESULT result);
+    std::uint64_t BeforeWriterFlush();
+    void AfterWriterFlush(std::uint64_t watermark, HRESULT result);
+    HRESULT ObserveStaleMaintenance(bool& active);
+    HRESULT Finalized(HRESULT result);
+    HRESULT Status();
+private:
+    HRESULT Fail(HRESULT result, const wchar_t* reason, LONGLONG pts = -1);
+    std::mutex m_Mutex;
+    EncodedTimingLedger m_Ledger;
+    HRESULT m_Failure = S_OK;
+    bool m_Active = false, m_Reported = false;
+    std::uint64_t m_Registered = 0, m_Accepted = 0, m_Matched = 0;
+    std::uint64_t m_FlushDiscarded = 0, m_Cancelled = 0, m_HighWater = 0;
+    std::uint64_t m_WriterFlushes = 0;
+    std::uint64_t m_ObservedStaleChecks = 0;
+};
+
+HRESULT WriteTimingTrackedSample(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream, IMFSample* sample);
+HRESULT FinalizeEncodedTiming(const std::shared_ptr<EncodedSampleTiming>& timing, HRESULT result);
+HRESULT FlushTimingTrackedWriter(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream);
diff --git a/ScreenRecorderLibNative/EncodedTimingLedger.h b/ScreenRecorderLibNative/EncodedTimingLedger.h
new file mode 100644
index 0000000..7425b85
--- /dev/null
+++ b/ScreenRecorderLibNative/EncodedTimingLedger.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <limits>
+
+// Pure bounded metadata. Callers provide synchronization; no sample/buffer is retained.
+class EncodedTimingLedger {
+public:
+    enum class Result { Ok, Invalid, Duplicate, Full, Unknown };
+    static constexpr std::size_t Capacity = 512;
+    Result Insert(std::int64_t pts, std::int64_t duration, std::uint64_t& token) noexcept {
+        if (pts < 0 || duration <= 0 || pts > (std::numeric_limits<std::int64_t>::max)() - duration)
+            return Result::Invalid;
+        if (pts == m_LastInputPts) return Result::Duplicate;
+        if (pts < m_LastInputPts) return Result::Invalid;
+        for (const auto& entry : m_Entries) if (entry.Used && entry.Pts == pts) return Result::Duplicate;
+        if (m_Count == Capacity) return Result::Full;
+        for (std::size_t offset = 0; offset < Capacity; ++offset) {
+            auto index = (m_Next + offset) % Capacity;
+            if (m_Entries[index].Used) continue;
+            token = ++m_Token;
+            m_Entries[index] = Entry{ pts, duration, token, true };
+            m_Next = (index + 1) % Capacity;
+            m_LastInputPts = pts;
+            ++m_Count;
+            return Result::Ok;
+        }
+        return Result::Full;
+    }
+    Result Take(std::int64_t pts, std::int64_t& duration) noexcept {
+        for (auto& entry : m_Entries) {
+            if (!entry.Used || entry.Pts != pts) continue;
+            duration = entry.Duration;
+            entry.Used = false;
+            --m_Count;
+            return Result::Ok;
+        }
+        return Result::Unknown;
+    }
+    bool Cancel(std::uint64_t token) noexcept {
+        for (auto& entry : m_Entries) {
+            if (!entry.Used || entry.Token != token) continue;
+            entry.Used = false;
+            --m_Count;
+            return true;
+        }
+        return false;
+    }
+    std::uint64_t Watermark() const noexcept { return m_Token; }
+    std::size_t DiscardThrough(std::uint64_t watermark) noexcept {
+        std::size_t removed = 0;
+        for (auto& entry : m_Entries) {
+            if (!entry.Used || entry.Token > watermark) continue;
+            entry.Used = false;
+            ++removed;
+        }
+        m_Count -= removed;
+        return removed;
+    }
+    std::size_t Clear() noexcept { return DiscardThrough(m_Token); }
+    std::size_t Count() const noexcept { return m_Count; }
+private:
+    struct Entry { std::int64_t Pts = 0, Duration = 0; std::uint64_t Token = 0; bool Used = false; };
+    std::array<Entry, Capacity> m_Entries{};
+    std::size_t m_Next = 0, m_Count = 0;
+    std::uint64_t m_Token = 0;
+    std::int64_t m_LastInputPts = -1;
+};
diff --git a/ScreenRecorderLibNative/EncodedTimingSink.cpp b/ScreenRecorderLibNative/EncodedTimingSink.cpp
new file mode 100644
index 0000000..88371f6
--- /dev/null
+++ b/ScreenRecorderLibNative/EncodedTimingSink.cpp
@@ -0,0 +1,143 @@
+#include "EncodedTimingSink.h"
+#include "EncodedTimingStream.h"
+#include <mferror.h>
+#include <mfapi.h>
+#include <vector>
+
+namespace {
+class EncodedTimingSink final : public IMFFinalizableMediaSink, public IMFClockStateSink,
+    public IMFMediaEventGenerator, public IMFGetService {
+public:
+    EncodedTimingSink(IMFMediaSink* inner, std::shared_ptr<EncodedSampleTiming> timing)
+        : m_Inner(inner), m_Finalizable(inner), m_Clock(inner), m_Events(inner), m_Service(inner), m_Timing(std::move(timing)) {}
+    HRESULT Initialize() {
+        if (!m_Finalizable) return E_NOINTERFACE;
+        DWORD count = 0;
+        HRESULT hr = m_Inner->GetStreamSinkCount(&count);
+        if (FAILED(hr)) return hr;
+        if (!count || count > 8) return MF_E_INVALIDSTREAMNUMBER;
+        unsigned videos = 0;
+        for (DWORD index = 0; index < count; ++index) {
+            CComPtr<IMFStreamSink> stream;
+            CComPtr<IMFMediaTypeHandler> handler;
+            DWORD id = 0;
+            GUID major{};
+            hr = m_Inner->GetStreamSinkByIndex(index, &stream);
+            if (SUCCEEDED(hr)) hr = stream->GetIdentifier(&id);
+            if (SUCCEEDED(hr)) hr = stream->GetMediaTypeHandler(&handler);
+            if (SUCCEEDED(hr)) hr = handler->GetMajorType(&major);
+            if (FAILED(hr)) return hr;
+            const bool video = major == MFMediaType_Video;
+            if (video) ++videos;
+            m_Ids.push_back(id);
+            m_Streams.push_back(std::make_unique<EncodedTimingStream>(static_cast<IMFMediaSink*>(this), stream, m_Timing, video));
+        }
+        return videos == 1 ? S_OK : MF_E_INVALIDMEDIATYPE;
+    }
+    STDMETHODIMP QueryInterface(REFIID iid, void** result) override {
+        if (!result) return E_POINTER;
+        *result = nullptr;
+        if (iid == __uuidof(IUnknown) || iid == __uuidof(IMFMediaSink) || iid == __uuidof(IMFFinalizableMediaSink))
+            *result = static_cast<IMFFinalizableMediaSink*>(this);
+        else if (iid == __uuidof(IMFClockStateSink) && m_Clock) *result = static_cast<IMFClockStateSink*>(this);
+        else if (iid == __uuidof(IMFMediaEventGenerator) && m_Events) *result = static_cast<IMFMediaEventGenerator*>(this);
+        else if (iid == __uuidof(IMFGetService) && m_Service) *result = static_cast<IMFGetService*>(this);
+        else return E_NOINTERFACE;
+        AddRef();
+        return S_OK;
+    }
+    STDMETHODIMP_(ULONG) AddRef() override { return InterlockedIncrement(&m_References); }
+    STDMETHODIMP_(ULONG) Release() override {
+        const ULONG count = InterlockedDecrement(&m_References);
+        if (!count) delete this;
+        return count;
+    }
+    STDMETHODIMP GetCharacteristics(DWORD* flags) override {
+        if (!flags) return E_POINTER;
+        HRESULT hr = m_Inner->GetCharacteristics(flags);
+        if (SUCCEEDED(hr)) *flags |= MEDIASINK_FIXED_STREAMS;
+        return hr;
+    }
+    STDMETHODIMP AddStreamSink(DWORD, IMFMediaType*, IMFStreamSink** stream) override {
+        if (stream) *stream = nullptr;
+        return MF_E_STREAMSINKS_FIXED;
+    }
+    STDMETHODIMP RemoveStreamSink(DWORD) override { return MF_E_STREAMSINKS_FIXED; }
+    STDMETHODIMP GetStreamSinkCount(DWORD* count) override {
+        if (!count) return E_POINTER;
+        *count = static_cast<DWORD>(m_Streams.size());
+        return S_OK;
+    }
+    STDMETHODIMP GetStreamSinkByIndex(DWORD index, IMFStreamSink** stream) override {
+        if (!stream) return E_POINTER;
+        *stream = nullptr;
+        if (index >= m_Streams.size()) return MF_E_INVALIDINDEX;
+        *stream = m_Streams[index].get();
+        (*stream)->AddRef();
+        return S_OK;
+    }
+    STDMETHODIMP GetStreamSinkById(DWORD id, IMFStreamSink** stream) override {
+        if (!stream) return E_POINTER;
+        for (std::size_t index = 0; index < m_Ids.size(); ++index)
+            if (m_Ids[index] == id) return GetStreamSinkByIndex(static_cast<DWORD>(index), stream);
+        *stream = nullptr;
+        return MF_E_INVALIDSTREAMNUMBER;
+    }
+    STDMETHODIMP SetPresentationClock(IMFPresentationClock* clock) override { return m_Inner->SetPresentationClock(clock); }
+    STDMETHODIMP GetPresentationClock(IMFPresentationClock** clock) override { return m_Inner->GetPresentationClock(clock); }
+    STDMETHODIMP Shutdown() override { return m_Inner->Shutdown(); }
+    STDMETHODIMP BeginFinalize(IMFAsyncCallback* callback, IUnknown* state) override {
+        HRESULT hr = m_Finalizable->BeginFinalize(callback, state);
+        m_Timing->OnFinalizeFailure(hr, true);
+        return hr;
+    }
+    STDMETHODIMP EndFinalize(IMFAsyncResult* result) override {
+        HRESULT hr = m_Finalizable->EndFinalize(result);
+        m_Timing->OnFinalizeFailure(hr, false);
+        return hr;
+    }
+    STDMETHODIMP OnClockStart(MFTIME system, LONGLONG offset) override { return m_Clock->OnClockStart(system, offset); }
+    STDMETHODIMP OnClockStop(MFTIME system) override { return m_Clock->OnClockStop(system); }
+    STDMETHODIMP OnClockPause(MFTIME system) override { return m_Clock->OnClockPause(system); }
+    STDMETHODIMP OnClockRestart(MFTIME system) override { return m_Clock->OnClockRestart(system); }
+    STDMETHODIMP OnClockSetRate(MFTIME system, float rate) override { return m_Clock->OnClockSetRate(system, rate); }
+    STDMETHODIMP GetEvent(DWORD flags, IMFMediaEvent** event) override { return m_Events->GetEvent(flags, event); }
+    STDMETHODIMP BeginGetEvent(IMFAsyncCallback* callback, IUnknown* state) override { return m_Events->BeginGetEvent(callback, state); }
+    STDMETHODIMP EndGetEvent(IMFAsyncResult* result, IMFMediaEvent** event) override { return m_Events->EndGetEvent(result, event); }
+    STDMETHODIMP QueueEvent(MediaEventType type, REFGUID extended, HRESULT status, const PROPVARIANT* value) override {
+        return m_Events->QueueEvent(type, extended, status, value);
+    }
+    STDMETHODIMP GetService(REFGUID service, REFIID iid, LPVOID* result) override { return m_Service->GetService(service, iid, result); }
+private:
+    volatile LONG m_References = 1;
+    CComPtr<IMFMediaSink> m_Inner;
+    CComQIPtr<IMFFinalizableMediaSink> m_Finalizable;
+    CComQIPtr<IMFClockStateSink> m_Clock;
+    CComQIPtr<IMFMediaEventGenerator> m_Events;
+    CComQIPtr<IMFGetService> m_Service;
+    std::shared_ptr<EncodedSampleTiming> m_Timing;
+    std::vector<DWORD> m_Ids;
+    std::vector<std::unique_ptr<EncodedTimingStream>> m_Streams;
+};
+}
+
+HRESULT WrapEncodedTimingSink(CComPtr<IMFMediaSink>& sink, bool hardwareRequested, bool fragmented,
+    std::shared_ptr<EncodedSampleTiming>& timing) {
+    timing.reset();
+    wchar_t flag[8]{};
+    const DWORD size = GetEnvironmentVariableW(L"FRAMEFLOW_CAPTURE_ENCODED_TIMING", flag, _countof(flag));
+    if (!hardwareRequested || !fragmented || (size == 1 && flag[0] == L'0')) return S_OK;
+    if (!sink) return E_POINTER;
+    try {
+        auto context = std::make_shared<EncodedSampleTiming>();
+        CComPtr<IMFMediaSink> wrapped;
+        auto* implementation = new EncodedTimingSink(sink, context);
+        wrapped.Attach(implementation);
+        HRESULT hr = implementation->Initialize();
+        if (FAILED(hr)) return hr;
+        sink = wrapped;
+        timing = std::move(context);
+        return S_OK;
+    } catch (const std::bad_alloc&) { return E_OUTOFMEMORY; }
+    catch (...) { return E_UNEXPECTED; }
+}
