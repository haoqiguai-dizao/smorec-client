+#pragma once
+#include "EncodedSampleTiming.h"
+#include <cwchar>
+
+inline bool IsStaleObservationRequested(const wchar_t* mode) noexcept {
+    return mode == nullptr || std::wcscmp(mode, L"flush") != 0;
+}
+
+inline bool ShouldObserveStaleWriter(bool requested, bool confirmedHardwareTiming, bool throttlingDisabled) noexcept {
+    return requested && confirmedHardwareTiming && !throttlingDisabled;
+}
+
+// Confirmed hardware retains pending samples under the writer's normal backpressure.
+HRESULT MaintainStaleWriter(const std::shared_ptr<EncodedSampleTiming>& timing,
+    IMFSinkWriter* writer, DWORD stream, bool throttlingDisabled);
