@@ -0,0 +1,59 @@
+#pragma once
+#include <atlbase.h>
+#include <mfidl.h>
+#include "EncodedSampleTiming.h"
+
+// Parent owns this object without a COM reference; external stream references keep the parent alive.
+class EncodedTimingStream final : public IMFStreamSink {
+public:
+    EncodedTimingStream(IMFMediaSink* owner, IMFStreamSink* inner,
+        std::shared_ptr<EncodedSampleTiming> timing, bool video)
+        : m_Owner(owner), m_Inner(inner), m_Timing(std::move(timing)), m_Video(video) {}
+    STDMETHODIMP QueryInterface(REFIID iid, void** result) override {
+        if (!result) return E_POINTER;
+        *result = nullptr;
+        if (iid == __uuidof(IUnknown) || iid == __uuidof(IMFStreamSink) || iid == __uuidof(IMFMediaEventGenerator))
+            *result = static_cast<IMFStreamSink*>(this);
+        else return E_NOINTERFACE;
+        AddRef();
+        return S_OK;
+    }
+    STDMETHODIMP_(ULONG) AddRef() override { return m_Owner->AddRef(); }
+    STDMETHODIMP_(ULONG) Release() override { return m_Owner->Release(); }
+    STDMETHODIMP GetMediaSink(IMFMediaSink** sink) override {
+        if (!sink) return E_POINTER;
+        *sink = m_Owner;
+        m_Owner->AddRef();
+        return S_OK;
+    }
+    STDMETHODIMP GetIdentifier(DWORD* id) override { return m_Inner->GetIdentifier(id); }
+    STDMETHODIMP GetMediaTypeHandler(IMFMediaTypeHandler** handler) override { return m_Inner->GetMediaTypeHandler(handler); }
+    STDMETHODIMP ProcessSample(IMFSample* sample) override {
+        if (m_Video) {
+            HRESULT hr = m_Timing->RestoreDuration(sample);
+            if (FAILED(hr)) return hr;
+        }
+        HRESULT hr = m_Inner->ProcessSample(sample);
+        if (m_Video) m_Timing->OnOutputFailure(hr);
+        return hr;
+    }
+    STDMETHODIMP PlaceMarker(MFSTREAMSINK_MARKER_TYPE type, const PROPVARIANT* value, const PROPVARIANT* context) override {
+        return m_Inner->PlaceMarker(type, value, context);
+    }
+    STDMETHODIMP Flush() override {
+        HRESULT hr = m_Inner->Flush();
+        if (m_Video) m_Timing->OnFlush(hr);
+        return hr;
+    }
+    STDMETHODIMP GetEvent(DWORD flags, IMFMediaEvent** event) override { return m_Inner->GetEvent(flags, event); }
+    STDMETHODIMP BeginGetEvent(IMFAsyncCallback* callback, IUnknown* state) override { return m_Inner->BeginGetEvent(callback, state); }
+    STDMETHODIMP EndGetEvent(IMFAsyncResult* result, IMFMediaEvent** event) override { return m_Inner->EndGetEvent(result, event); }
+    STDMETHODIMP QueueEvent(MediaEventType type, REFGUID extended, HRESULT status, const PROPVARIANT* value) override {
+        return m_Inner->QueueEvent(type, extended, status, value);
+    }
+private:
+    IMFMediaSink* m_Owner;
+    CComPtr<IMFStreamSink> m_Inner;
+    std::shared_ptr<EncodedSampleTiming> m_Timing;
+    bool m_Video;
+};
diff --git a/ScreenRecorderLibNative/MediaClockOrigin.h b/ScreenRecorderLibNative/MediaClockOrigin.h
new file mode 100644
index 0000000..f6c537f
--- /dev/null
+++ b/ScreenRecorderLibNative/MediaClockOrigin.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <mfidl.h>
+#include <atlbase.h>
+
+inline LONGLONG MediaClockOriginFromCorrelation(LONGLONG presentation100ns, LONGLONG systemQpc100ns) noexcept {
+    if (presentation100ns < 0 || systemQpc100ns <= 0 || systemQpc100ns < presentation100ns) return -1;
+    return systemQpc100ns - presentation100ns;
+}
+
+// IMFPresentationClock and its correlated QPC system time both use 100ns units.
+// This is a read-only mapping valid while running at 1x; retain the first value.
+inline LONGLONG ReadMediaClockOriginQpc100ns(IMFPresentationClock* clock) {
+    if (!clock) return -1;
+    MFCLOCK_STATE state = MFCLOCK_STATE_INVALID;
+    if (FAILED(clock->GetState(0, &state)) || state != MFCLOCK_STATE_RUNNING) return -1;
+    CComQIPtr<IMFRateControl> rateControl(clock);
+    BOOL thin = FALSE;
+    float rate = 0;
+    if (!rateControl || FAILED(rateControl->GetRate(&thin, &rate)) || rate != 1.0f) return -1;
+    LONGLONG presentation = 0;
+    MFTIME system = 0;
+    if (FAILED(clock->GetCorrelatedTime(0, &presentation, &system))) return -1;
+    if (FAILED(clock->GetState(0, &state)) || state != MFCLOCK_STATE_RUNNING) return -1;
+    return MediaClockOriginFromCorrelation(presentation, system);
+}
